# ai 서버 환경변수 템플릿. 복사해서 같은 디렉터리에 .env 로 쓴다.
#   cp src/.env.example src/.env
#
# 우선순위: 명령줄 플래그 > 프로세스 환경변수 > 이 파일 > 코드의 기본값.
# 여기 적은 값은 전부 실제로 먹는다. 유일한 예외는 AI_COMPLETION_LOG — 아래 그 항목에서
# 설명한다.
#
# .env 는 커밋하지 않는다 (이 파일 .env.example 은 커밋한다).

# ---- 서버 -------------------------------------------------------------------
# 내부 API 인증 키. Spring 이 X-Internal-Api-Key 헤더로 보내는 값과 같아야 한다.
# 비어 있으면 /internal/v1 의 모든 요청이 401 이다 (deps.py).
INTERNAL_API_KEY=

# Spring Boot Wiki 조회 API 주소. **없으면 서버가 뜨지 않는다** — 위키 변환이 이 주소로
# 목차·카테고리·본문을 읽는다 (S15P11B106-175).
BACKEND_BASE_URL=http://localhost:8080

# 저장소 루트(sources/·wiki/·.llmwiki/index.db)는 환경변수로 주지 않는다.
# 프로세스 1개 = 저장소 루트 1개 = 스코프 1개 = 작업 1개 이므로 프로세스마다 달라야 한다.
# CLI 로 준다 — local_server.py 의 root/--root, graph_api.py 의 --root.

# 툴 응답의 "[View](...)" 딥링크를 만들 때만 쓴다. 에이전트가 이 주소를 호출하지는 않는다.
APP_URL=http://localhost:3000

# ---- 런타임 ------------------------------------------------------------------
# claude-code | deepagents. 기본은 deepagents 다 — push 경로가 사라져(S15P11B106-175)
# claude-code(하위 프로세스, MCP 서버가 다른 프로세스라 조회 API 도구가 닿지 않는다)로는
# 위키 엔드포인트를 하나도 못 쓴다. 로컬에서 claude-code 를 쓰려면(로그인 세션 과금,
# API 키 불필요) 명시로 바꾼다 — 그때는 챗봇(/answers)·파싱(/source-parses)만 된다.
# 오타는 기동 시점에 터진다 — 조용히 기본값으로 떨어지지 않는다.
AI_RUNTIME=deepagents

# 에이전트 모델. 정확한 이름을 쓴다 — 별칭은 시점에 따라 다른 모델로 해석돼
# 두 측정의 비교를 조용히 깨뜨린다. 비우면 코드 기본값(anthropic:claude-sonnet-4-6)을
# 쓴다 — 실측용으로 더 비싼 모델을 쓰려면 여기서 명시로 바꾼다(예: claude-opus-4-6).
# AI_MODEL=anthropic:claude-sonnet-4-6

# 티어별 모델 (단발 호출용). 비우면 코드의 측정된 기본값을 쓴다.
# AI_MODEL_FAST=anthropic:claude-haiku-4-5-20251001
# AI_MODEL_QUALITY=anthropic:claude-sonnet-4-6

# ---- 스캔 PDF 비전 OCR --------------------------------------------------------
# gemini | anthropic. 기본은 gemini 다 — GMS 게이트웨이가 요청 본문 크기를 대략
# 100KB 로 제한해서(실측), 200dpi 로 렌더한 실제 스캔 페이지 대부분이 여기 걸려
# "model not found" 로 잘못 보고됐다(모델이 없는 게 아니라 게이트웨이가 큰 요청을
# 못 읽어서 나는 오류). Google API 는 GMS 를 거치지 않아 이 제약이 없다.
# VISION_OCR_PROVIDER=gemini

# Google AI Studio 에서 발급받은 키. 비어 있으면 gemini 를 골라도 None → 로컬
# Tesseract 로 폴백한다(기동을 막지 않는다).
GEMINI_API_KEY=

# 비우면 코드 기본값을 쓴다. `gemini-2.0-flash` 계열은 무료 티어 할당량이 0으로
# 배정된 경우가 있었다(2026-08-03 실측) — 그럴 땐 `gemini-flash-lite-latest` 처럼
# 실제로 요청이 통과하는 이름으로 바꾼다.
# GEMINI_MODEL=gemini-flash-lite-latest

# 비우면 공개 Google API 주소를 그대로 쓴다. 테스트용 프록시가 있을 때만 바꾼다.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# VISION_OCR_PROVIDER=anthropic 으로 바꾸면 위 AI_MODEL_FAST(GMS/haiku)를 재사용한다
# — 다만 GMS 크기 제한 때문에 실제 스캔 페이지 대부분에서 터질 수 있다.

# ---- 일정 추출 (schedule-extractions) ----------------------------------------
# 이 엔드포인트만 에이전트 런타임을 쓰지 않는다 — 상태 없는 단발 구조화 출력이라
# 자기 어댑터를 고른다. **기본은 anthropic(GMS)/haiku 다** — 배포 서버에 GPU 가 없어
# ollama 를 못 띄우기 때문이다 (S15P11B106-180). 로컬에서 무과금으로 측정할 때만
# 아래 두 줄을 살려 ollama 로 바꾼다.
#
# anthropic 은 ANTHROPIC_API_KEY 가 없으면 기동에서 죽는다(schedule_extractor/config.py)
# — 조용한 500 대신 시끄럽게 실패한다. 기동 한 줄("AI 서버 — … 일정 추출 <프로바이더>/
# <모델> @ <주소>")로 무엇으로 떴는지 확인한다.
# SCHEDULE_EXTRACTOR_PROVIDER=ollama

# 비우면 프로바이더별 기본값 (anthropic: claude-haiku-4-5-20251001, ollama: qwen2.5:7b-instruct).
# 일정 추출은 값싼 티어로 충분하다. 더 큰 모델이 필요하면 여기서 바꾼다.
# SCHEDULE_EXTRACTOR_MODEL=

# ollama 로 바꿀 때의 로컬 주소. anthropic 일 때 비워 두면 아래 ANTHROPIC_BASE_URL(GMS)을
# 그대로 쓴다 — 키와 주소를 두 번 적으면 한쪽만 갱신되는 사고가 난다.
# SCHEDULE_EXTRACTOR_BASE_URL=http://localhost:11434

# 백엔드가 180초에 끊는다(application.yml). 그보다 먼저 끊어야 계약이 정한 500 으로 나간다.
SCHEDULE_EXTRACTOR_TIMEOUT_SECONDS=170

# ---- 모델 자격증명 (deepagents 런타임과 일정 추출 anthropic 어댑터가 쓴다) --------
# claude-code 는 로그인 세션으로 과금하므로 아래 값이 없어도 된다.
# 오히려 claude-code 로 뜨는 동안에는 이 키가 쓰이지 않는다 (일정 추출은 별개다 —
# provider=anthropic 이면 런타임과 무관하게 이 키를 쓴다).
#
# SSAFY GMS 게이트웨이는 키 하나로 Anthropic·OpenAI 를 모두 프록시한다.
# BASE_URL 패턴은 https://gms.ssafy.io/gmsapi/<업스트림 호스트>
#
# GMS 에서 확인된 Anthropic 모델 (2026-07-29):
#   claude-haiku-4-5-20251001   claude-sonnet-4-6
#   claude-sonnet-4-5-20250929  claude-opus-4-6
# 없는 것: claude-sonnet-5, claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com

# OpenAI 로 돌릴 때. 배선 확인용이고 품질 측정용이 아니다 —
# 모델이 다르면 비교가 깨진다 (experiments/INDEX.md 의 대조 규칙).
# 개인 키를 직접 쓸 때는 OPENAI_BASE_URL 을 비운다.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- 관측 (LangSmith) --------------------------------------------------------
# 에이전트 실행 트레이스를 LangSmith 에 남긴다. 셋 다 있어야 켜진다 — 하나라도
# 비면 `configure_langsmith`(serve.py)가 아무것도 안 한다. langsmith SDK 는
# `os.environ` 을 직접 보는 서드파티라, 여기 값은 기동 시점에 `os.environ` 으로
# 한 번 되심어진다(그전엔 `ServerSettings` 에 필드가 없어 `.env` 에 적어도 조용히
# 버려졌다 — 2026-08-04).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# ---- 관측 (프로세스 환경 전용 — 이 파일에 적어도 무시된다) ---------------------
# `complete` 호출 1건을 JSONL 로 남길 경로. `wiki_api/telemetry.py` 가 호출 시점에
# `os.environ` 을 직접 읽는다.
#
# 다른 변수와 달리 여기서 `ServerSettings` 로 옮기지 않았다: 이 값은 `wiki_api/serve.py`
# (조립 지점)를 거치지 않고 `wiki_api/completion.py` 깊숙한 곳에서 바로 쓰이고, 그 호출자
# (answer·selection·answer_selection 세 라우터)는 지금 설정 객체를 들고 있지 않다.
# 옮기려면 그 라우터들과 `complete()`·`record()` 시그니처까지 고쳐야 해 배선 비용이
# 이 브랜치의 범위(설정 읽기 통합)보다 크다고 판단해 남겨 둔다.
# **`.env` 에 적어도 조용히 무시된다.** 실제로 쓰려면 서버를 띄우는 셸에서
# `export AI_COMPLETION_LOG=...` 로 설정한다.
# AI_COMPLETION_LOG=
