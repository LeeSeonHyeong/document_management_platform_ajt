# ================================================================
# AJT 배포용 환경변수 목록 (.env.example)
#
# - 이 파일은 "어떤 변수가 필요한지" 알려주는 문서. 값은 비워둔다 → git 커밋 O.
# - 실제 값은 서버의 .env (또는 repo 밖 secrets 파일)에만 넣는다 → git 커밋 X.
# - 표식:  🔴 비밀(강한 랜덤/실제 값, 절대 커밋 금지)   🟡 환경설정(운영값 지정)   ⚪ 선택(기본값 있음)
# - 비밀키 생성:  openssl rand -base64 48
# ================================================================

# --- 프로파일 전환 ---
# 🟡 local(H2) 끄고 운영 모드로. ⚠️ 아래 DB 설정이 있어야 기동됨.
SPRING_PROFILES_ACTIVE=prod

# --- 배포 이미지 / Compose ---
# 🟡 Jenkins가 빌드한 Git commit SHA(7~40자). 운영에서 latest 태그를 사용하지 않는다.
IMAGE_TAG=
BACKEND_IMAGE=ajt-backend
FRONTEND_IMAGE=ajt-frontend
AI_IMAGE=ajt-ai
FRONTEND_PORT=443

# 🟡 같은 서버의 develop 검증 스택과 운영 스택이 데이터를 공유하지 않도록 환경별로 다르게 지정한다.
MYSQL_VOLUME_NAME=ajt-prod-mysql-data
AJT_FILES_VOLUME_NAME=ajt-prod-files

# --- 인증 비밀키 ---
AJT_ACCESS_TOKEN_SECRET=        # 🔴 JWT 서명키 (이거 유출=토큰 위조 가능)
AJT_PASSWORD_RESET_SECRET=      # 🔴 비밀번호 재설정 토큰 서명키
AJT_AUTH_COOKIE_SECURE=true     # 🟡 HTTPS 붙인 뒤 true (http 테스트 땐 false)

# --- 데이터베이스 (MySQL) ---
# 🟡 compose면 host 자리에 MySQL 컨테이너명(예: mysql). DB명은 erd.sql/팀 규칙에 맞출 것.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ajt?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=ajt
SPRING_DATASOURCE_PASSWORD=     # 🔴

# MySQL 컨테이너 초기화용 (docker-compose 에서 mysql 서비스에 넣음)
MYSQL_ROOT_PASSWORD=            # 🔴
MYSQL_DATABASE=ajt              # 🟡 (SPRING_DATASOURCE_URL의 DB명과 일치)
MYSQL_USER=ajt                  # 🟡 (SPRING_DATASOURCE_USERNAME과 일치)
MYSQL_PASSWORD=                 # 🔴 (SPRING_DATASOURCE_PASSWORD와 동일하게)

# --- 내부 AI 연동 (같은 Compose의 FastAPI 서비스) ---
# backend의 AI_BASE_URL은 Compose가 http://ai:8000 으로 고정한다.
# AI 런타임, 일정 추출, OCR은 모두 SSAFY GMS Anthropic 경로를 사용하며 Ollama를 사용하지 않는다.
AI_INTERNAL_API_KEY=            # 🔴 Spring과 FastAPI가 공유하는 내부 호출 키
ANTHROPIC_API_KEY=              # 🔴 SSAFY GMS API 키

# --- 파일 저장 경로 (영속 볼륨에 마운트) ---
# 🟡 컨테이너 내부 build/ 대신, 볼륨으로 마운트된 경로. 안 하면 재시작 시 업로드 파일 소실.
#    실제 경로 구조는 docs 의 디렉터리 구조 문서에 맞출 것.
DOCUMENT_STORAGE_ROOT=/data/ajt/documents
SCHEDULE_SOURCE_STORAGE_ROOT=/data/ajt/schedule-sources
INQUIRY_STORAGE_ROOT=/data/ajt/inquiries

# --- 선택 (기본값 있어 보통 생략) ---
# ⚪ AJT_ACCESS_TOKEN_EXPIRATION=1h
# ⚪ AJT_PASSWORD_RESET_EXPIRATION=30m
# ⚪ AI_CONNECT_TIMEOUT=5s
# ⚪ AI_READ_TIMEOUT=10m
# ⚪ AI_SCHEDULE_EXTRACTION_READ_TIMEOUT=180s
