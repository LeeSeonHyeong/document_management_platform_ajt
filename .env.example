# ================================================================
# AJT 배포용 환경변수 목록 (.env.example)
#
# - 이 파일은 "어떤 변수가 필요한지" 알려주는 문서. 값은 비워둔다 → git 커밋 O.
# - 실제 값은 서버의 .env (또는 repo 밖 secrets 파일)에만 넣는다 → git 커밋 X.
# - 표식:  🔴 비밀(강한 랜덤/실제 값, 절대 커밋 금지)   🟡 환경설정(운영값 지정)   ⚪ 선택(기본값 있음)
# - 비밀키 생성:  openssl rand -base64 48
# ================================================================

# --- 프로파일 전환 ---
# 🟡 local(H2) 끄고 운영 모드로. ⚠️ 아래 DB 설정이 있어야 기동됨.
SPRING_PROFILES_ACTIVE=prod

# --- 배포 이미지 / Compose ---
# 🟡 Jenkins가 빌드한 Git commit SHA(7~40자). 운영에서 latest 태그를 사용하지 않는다.
IMAGE_TAG=
BACKEND_IMAGE=ajt-backend
FRONTEND_IMAGE=ajt-frontend
AI_IMAGE=ajt-ai
FRONTEND_PORT=443

# 🟡 같은 서버의 develop 검증 스택과 운영 스택이 데이터를 공유하지 않도록 환경별로 다르게 지정한다.
MYSQL_VOLUME_NAME=ajt-prod-mysql-data
AJT_FILES_VOLUME_NAME=ajt-prod-files

# --- 인증 비밀키 ---
AJT_ACCESS_TOKEN_SECRET=        # 🔴 JWT 서명키 (이거 유출=토큰 위조 가능)
AJT_PASSWORD_RESET_SECRET=      # 🔴 비밀번호 재설정 토큰 서명키
AJT_AUTH_COOKIE_SECURE=true     # 🟡 HTTPS 붙인 뒤 true (http 테스트 땐 false)

# --- 최고관리자 식별 ---
# 🟡 이 이메일 계정만 최고관리자다 (role=ADMIN + APPROVED + ACTIVE + 이메일 일치).
#    scripts/bootstrap-admin.sh 가 이 값을 읽어 최초 계정을 만든다.
#    바꾸면 DB의 계정 이메일도 함께 바꿔야 한다 — 어긋나면 최고관리자가 0명이 되어
#    가입 승인 메뉴와 위키 수정 대화가 화면에서 사라진다.
SUPER_ADMIN_EMAIL=superadmin@ajt.com

# --- 데이터베이스 (MySQL) ---
# 🟡 compose면 host 자리에 MySQL 컨테이너명(예: mysql). DB명은 erd.sql/팀 규칙에 맞출 것.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ajt?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=ajt
SPRING_DATASOURCE_PASSWORD=     # 🔴

# MySQL 컨테이너 초기화용 (docker-compose 에서 mysql 서비스에 넣음)
MYSQL_ROOT_PASSWORD=            # 🔴
MYSQL_DATABASE=ajt              # 🟡 (SPRING_DATASOURCE_URL의 DB명과 일치)
MYSQL_USER=ajt                  # 🟡 (SPRING_DATASOURCE_USERNAME과 일치)
MYSQL_PASSWORD=                 # 🔴 (SPRING_DATASOURCE_PASSWORD와 동일하게)

# --- 내부 AI 연동 (같은 Compose의 FastAPI 서비스) ---
# backend의 AI_BASE_URL은 Compose가 http://ai:8000 으로 고정한다.
# AI 런타임과 일정 추출은 SSAFY GMS Anthropic 경로를 사용하며 Ollama를 사용하지 않는다.
# 스캔 PDF OCR만 Google Gemini를 쓴다 — GMS 게이트웨이의 ~100KB 본문 제한 때문에
# 실제 스캔 페이지가 Anthropic 경로에선 거의 다 실패한다(compose의 ai 서비스 주석 참고).
AI_INTERNAL_API_KEY=            # 🔴 Spring과 FastAPI가 공유하는 내부 호출 키
ANTHROPIC_API_KEY=              # 🔴 Anthropic API 키. 아래 BASE_URL 과 발급처가 같아야 한다
# 🟡 비우면 api.anthropic.com 을 직접 호출한다 (현재 배포 설정).
#    SSAFY GMS 크레딧을 쓰려면 아래 주석을 풀고 위 키도 GMS 발급 키로 바꾼다 — 둘을 함께 바꿔야 한다.
#    주소만 GMS 이고 키가 Anthropic 발급 키이면 게이트웨이 인증에 실패한다(401).
ANTHROPIC_BASE_URL=
# ANTHROPIC_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com
GEMINI_API_KEY=                 # 🔴 Google AI Studio 키. 비면 스캔 PDF OCR이 로컬 Tesseract로 폴백(한글 언어팩 없으면 실패)
# ⚪ Google API 프록시를 사용할 때만 설정. 비우면 공개 Google API 주소를 쓴다.
GEMINI_BASE_URL=
# ⚪ 일정 추출만 별도 주소를 시험할 때 사용. 비우면 ANTHROPIC_BASE_URL을 재사용한다.
SCHEDULE_EXTRACTOR_BASE_URL=
# ⚪ AI 내부 일정 추출/OCR 요청 제한. 백엔드 180초 제한보다 먼저 종료한다.
SCHEDULE_EXTRACTOR_TIMEOUT_SECONDS=170

# --- 에이전트 관측 (선택: LangSmith) ---
# ⚪ true와 API 키, 프로젝트명을 모두 설정한 경우에만 트레이스를 전송한다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- 메일 (비밀번호 재설정 인증번호 발송) ---
# 🟡 네이버 메일은 환경설정 → POP3/IMAP 설정에서 IMAP/SMTP 사용함으로 바꿔야 한다.
#    2단계 인증 계정이면 애플리케이션 비밀번호를 따로 발급해 MAIL_PASSWORD 에 넣는다.
#    비워도 기동은 되지만 비밀번호 재설정 메일이 나가지 않고, Actuator health 가
#    DOWN 으로 보인다(MailHealthIndicator). 배포 실패로 오해하지 않도록 주의.
MAIL_HOST=smtp.naver.com
MAIL_PORT=465
MAIL_USERNAME=                  # 🟡 네이버 아이디 (@naver.com 제외)
MAIL_PASSWORD=                  # 🔴 비밀번호 또는 앱 비밀번호
MAIL_FROM=noreply@ajt.local     # 🟡 발신 표기 주소

# --- 파일 저장 경로 (영속 볼륨에 마운트) ---
# 🟡 컨테이너 내부 build/ 대신, 볼륨으로 마운트된 경로. 안 하면 재시작 시 업로드 파일 소실.
#    실제 경로 구조는 docs 의 디렉터리 구조 문서에 맞출 것.
DOCUMENT_STORAGE_ROOT=/data/ajt/documents
SCHEDULE_SOURCE_STORAGE_ROOT=/data/ajt/schedule-sources
INQUIRY_STORAGE_ROOT=/data/ajt/inquiries

# --- 선택 (기본값 있어 보통 생략) ---
# ⚪ AJT_ACCESS_TOKEN_EXPIRATION=1h
# ⚪ AJT_PASSWORD_RESET_EXPIRATION=30m
# ⚪ AI_CONNECT_TIMEOUT=5s
# ⚪ AI_READ_TIMEOUT=10m
# ⚪ AI_SCHEDULE_EXTRACTION_READ_TIMEOUT=180s
