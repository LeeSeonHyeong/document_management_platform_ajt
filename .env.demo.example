# ================================================================
# AJT 시연용 데모 스택 환경변수 (.env.demo.example)
#
# - docker-compose.demo.yml 전용. 운영은 .env.example 을 쓴다.
# - 복사해서 값을 채운다:  cp .env.demo.example .env.demo
# - 실행: docker compose -f docker-compose.demo.yml -p demo --env-file .env.demo up -d --build
#
# ⚠️ 이 파일이 없으면 compose 가 env_file 을 못 찾아 기동 자체가 실패한다.
#    (docker-compose.demo.yml 의 env_file: ["${COMPANY_ENV:-.env.demo}"])
#
# ⚠️ H2 인메모리라 컨테이너를 재시작하면 데이터가 초기화된다. 운영에 쓰지 않는다.
#    DB 덤프로 복원한 데이터를 보려면 데모 스택이 아니라 운영 compose 를 쓴다.
# ================================================================

# --- 프로파일 ---
# local 프로파일이라 H2 인메모리 + LocalDataInitializer 더미데이터가 자동 시드된다.
# 로그인: admin@ajt.com / password123!  (그 외 계정도 모두 password123!)
SPRING_PROFILES_ACTIVE=local

# --- 인증 ---
# 프론트가 443(TLS)으로 서비스하므로 true 로 둔다. HTTP 로 접속하면 로그인 직후 풀린다.
AJT_AUTH_COOKIE_SECURE=true

# 비워도 로컬 기본값으로 기동되지만, 데모라도 공개 주소에 띄운다면 실제 값을 넣는다.
# 비밀키 생성: openssl rand -base64 48
AJT_ACCESS_TOKEN_SECRET=
AJT_PASSWORD_RESET_SECRET=

# --- AI 연동 ---
# ⚠️ 비우면 백엔드가 기동에 실패한다 (AiApiProperties 가 빈 값을 거부).
#    데모 스택에는 ai 컨테이너가 없어 실제 호출은 되지 않지만, 값 자체는 있어야 뜬다.
#    AI 기능까지 시연하려면 데모 스택이 아니라 운영 compose 를 쓴다.
AI_INTERNAL_API_KEY=demo-internal-key

# --- 포트 ---
# 운영(443)과 겹치지 않게 8090 을 쓴다.
FRONTEND_PORT=8090
